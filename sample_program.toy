// Demonstration program for the upgraded TOC toy compiler

let x = 5;
let y = 10;
let sum = 0;

// if / else using comparison operators
if (x < y) {
    print(x);
} else {
    print(y);
}

// while loop
while (x <= y) {
    sum = sum + x;
    x = x + 1;
}

// print the final sum
print(sum);

// another condition
if (sum == 45) {
    print(sum);
} else {
    print(0);
}