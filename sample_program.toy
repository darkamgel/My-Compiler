// Extended demo program

let name = input("Enter your name: ");
let age = input("Enter your age: ");

print("Hello, " + name);

if ((age >= 18) && (age < 100)) {
    print("You are an adult.");
} else {
    print("You are not an adult.");
}

let total = 0;

// for loop
for (let i = 1; i <= 5; i = i + 1) {
    total = total + i;
}

print("Sum from 1 to 5 = " + total);

// while loop
let counter = 3;
while ((counter > 0) || (name == "")) {
    print("Counter = " + counter);
    counter = counter - 1;
}

// boolean not
if (!(age == 0)) {
    print("Age is not zero.");
}